# os42-orchestrator — cloud environment variable map.
#
# Every env var the app actually reads (grep of app/**/*.py, 2026-09-03).
# Copy to a secrets manager / platform env UI; do NOT commit a filled-in copy.
# Columns: NAME  — default in code — what to set in the cloud.

# ─────────────────────────────────────────────────────────────────────────
# SECRETS — override the dev defaults or the instance is trivially ownable
# ─────────────────────────────────────────────────────────────────────────

# Admin key for POST /scheduler/{pause,resume}. Code default is the shared
# dev string "os42_dev_admin_key". MUST be overridden.
#   gen: python -c "import secrets;print('os42_admin_'+secrets.token_urlsafe(32))"
OS42_ADMIN_KEY=

# API key for the auto-provisioned default tenant (the one used when a
# request carries no tenant key). Code default "os42_dev_default_key".
# Override so the public instance isn't wide open on the default tenant.
#   gen: python -c "import secrets;print('os42_'+secrets.token_urlsafe(32))"
OS42_DEFAULT_API_KEY=

# Outbound bearer token the engines would use to verify the orchestrator.
# Leave BLANK — there is no real Unkey workspace in the fleet yet, and
# engine_auth_headers() correctly sends no header when this is unset.
UNKEY_API_KEY=

# ─────────────────────────────────────────────────────────────────────────
# CONFIG — non-secret, safe to set as plain platform env
# ─────────────────────────────────────────────────────────────────────────

# CORS allow-list, comma-separated. Code default "" = deny all browsers
# (SECURITY_REVIEW.md #1: no wildcard-with-credentials). Set only when a
# real browser UI origin exists, e.g. https://os42-ui.example.com
ALLOWED_ORIGINS=

# AutonomousScheduler tick interval, seconds. Default 300. Every tick
# currently analyses an empty metric set and emits a RESUME no-op
# (STAGE5_PLAN.md finding 1) — raising this to e.g. 900 on a sleepy
# free instance costs nothing.
OS42_SCHEDULER_INTERVAL_SECONDS=300

# Enables JSON-snapshot persistence when set (unset = pure in-memory).
#   Render free : /tmp/os42_snapshot.json  — ephemeral, wiped on every
#                 restart/deploy/spin-down. Set it anyway; it still helps
#                 within a single uptime.
#   Fly + volume: /data/os42_snapshot.json — survives restarts.
OS42_PERSISTENCE_PATH=/tmp/os42_snapshot.json

# Identity of the auto-provisioned default tenant. Cosmetic; defaults fine.
OS42_DEFAULT_TENANT_ID=default

# ─────────────────────────────────────────────────────────────────────────
# DOWNSTREAM ENGINE URLS
# Code defaults are http://localhost:80xx — wrong in the cloud but HARMLESS:
# every engine call is wrapped and a connection failure is caught per-call;
# /status reports them as "configured" without probing. Point at a dummy
# closed port so nothing hangs on DNS. Fill in real URLs only if you ever
# deploy an engine.
# ─────────────────────────────────────────────────────────────────────────
CONTENT_ENGINE_URL=http://127.0.0.1:9
MARKETING_ENGINE_URL=http://127.0.0.1:9
ANALYTICS_ENGINE_URL=http://127.0.0.1:9
MONITORING_ENGINE_URL=http://127.0.0.1:9
NOTIFICATION_ENGINE_URL=http://127.0.0.1:9
SALES_ENGINE_URL=http://127.0.0.1:9
REVENUE_ENGINE_URL=http://127.0.0.1:9
INTEGRATION_ENGINE_URL=http://127.0.0.1:9
SUPPORT_ENGINE_URL=http://127.0.0.1:9
GOVERNANCE_ENGINE_URL=http://127.0.0.1:9

# ─────────────────────────────────────────────────────────────────────────
# NOT USED YET — do not set
# ─────────────────────────────────────────────────────────────────────────
# DATABASE_URL — the orchestrator has no DB layer today. See RUNBOOK.md §5.3
# for the plan to add a Postgres-backed persistence store; until that code
# exists, a Neon/Supabase URL here does nothing.
# PORT — injected by the platform (Render/Fly). The Dockerfile CMD already
# honours it; only set it manually for a bare `docker run`.
